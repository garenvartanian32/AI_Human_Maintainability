# Ignore everything by default
/*

# Repository files
!/.gitignore
!/README.md
!/requirements.txt

# Python scripts and JSONL exports
!/*.py
!/*.jsonl

# Experimental folders
!/datasets/
!/experiments/
!/thesis_work/

# Exclude temporary and sensitive files
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example

# Large dataset files (download separately)
datasets/human_vs_ai_quality/java_dataset.jsonl
datasets/human_vs_ai_quality/python_dataset.jsonl

# Large generated results
thesis_work/results/hvai_full.csv
